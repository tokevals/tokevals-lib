{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tokevals/tokevals-lib/blob/main/catalog/schema.json",
  "title": "TokEvals model catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "providers", "tokenizers", "models"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "catalogVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provider" }
    },
    "tokenizers": {
      "type": "array",
      "minItems": 1,
      "items": { "oneOf": [
        { "$ref": "#/$defs/coreTokenizer" },
        { "$ref": "#/$defs/openTokenizer" }
      ] }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "oneOf": [
        { "$ref": "#/$defs/localModel" },
        { "$ref": "#/$defs/apiModel" }
      ] }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "text": { "type": "string", "minLength": 1 },
    "accent": { "enum": ["coral", "blue"] },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mark"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "mark": { "$ref": "#/$defs/text" }
      }
    },
    "coreTokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "provider", "encoding", "label", "accent"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "core" },
        "provider": { "$ref": "#/$defs/id" },
        "encoding": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "accent": { "$ref": "#/$defs/accent" },
        "sourceUrl": { "$ref": "#/$defs/text" }
      }
    },
    "openTokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "provider", "encoding", "label", "accent", "repository", "revision", "decoder", "supportsBoundaries"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "open" },
        "provider": { "$ref": "#/$defs/id" },
        "encoding": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "accent": { "$ref": "#/$defs/accent" },
        "repository": { "$ref": "#/$defs/text" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "decoder": { "enum": ["byte_level", "sentencepiece", "native_sentencepiece", "tiktoken"] },
        "supportsBoundaries": { "type": "boolean" },
        "sourceUrl": { "$ref": "#/$defs/text" },
        "artifactUrl": { "$ref": "#/$defs/text" },
        "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifactSizeBytes": { "type": "integer", "minimum": 1 },
        "pattern": { "$ref": "#/$defs/text" },
        "normalization": { "enum": ["NFC", "NFD", "NFKC", "NFKD"] },
        "boundaryLimitation": { "$ref": "#/$defs/text" }
      }
    },
    "localModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "provider", "name", "tokenizerId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "local" },
        "provider": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "tokenizerId": { "$ref": "#/$defs/id" },
        "tokenizerProvider": { "$ref": "#/$defs/id" }
      }
    },
    "apiModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "provider", "encoding", "label", "modelExamples", "accent", "upstreamModel", "capability", "countSource", "supportsBoundaries"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "hosted" },
        "provider": { "$ref": "#/$defs/id" },
        "encoding": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "modelExamples": { "$ref": "#/$defs/text" },
        "accent": { "$ref": "#/$defs/accent" },
        "upstreamModel": { "$ref": "#/$defs/text" },
        "capability": { "enum": ["count_only", "token_breakdown"] },
        "countSource": { "enum": ["hosted_message_count", "hosted_input_count", "hosted_token_breakdown"] },
        "supportsBoundaries": { "type": "boolean" },
        "sourceUrl": { "$ref": "#/$defs/text" },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
